<?xml version="1.0" encoding="utf-8"?>
<!--
  RingQswitch core configuration.

  Every file under conf/ is pre-processed before parsing: $${name} is replaced
  with the global variable "name" defined below. Built-in variables:
    local_ip_v4  address of the interface holding the default route
    hostname     machine host name
    conf_dir     absolute path of this directory
    base_dir     parent of conf_dir
-->
<configuration>
  <vars>
    <!-- SIP domain / digest realm. Phones register to this. -->
    <var name="domain" value="$${local_ip_v4}"/>
    <!-- Password used by the sample extensions. CHANGE IT before exposing the PBX. -->
    <var name="default_password" value="ChangeMe-1234"/>
    <!-- Handy tones for the dialplan (teletone syntax: %(on_ms,off_ms,freq...)). -->
    <var name="us-ring" value="%(2000,4000,440,480)"/>
    <var name="uk-ring" value="%(400,200,400,450);%(400,2000,400,450)"/>
    <var name="busy" value="%(500,500,480,620)"/>
    <var name="beep" value="%(300,100,1000);loops=1"/>
  </vars>

  <settings>
    <param name="log-level" value="info"/>              <!-- debug | info | warn | error -->
    <param name="sip-trace" value="false"/>             <!-- log every SIP message at debug level -->

    <!-- Signalling. "auto" binds all interfaces and advertises local_ip_v4. -->
    <param name="sip-ip" value="auto"/>
    <param name="sip-port" value="5060"/>
    <param name="enable-tcp" value="true"/>
    <!-- Public address advertised to peers outside RFC 1918 space (NAT). -->
    <param name="ext-sip-ip" value=""/>

    <!-- Media -->
    <param name="rtp-ip" value="auto"/>
    <param name="ext-rtp-ip" value=""/>
    <param name="rtp-start-port" value="16384"/>
    <param name="rtp-end-port" value="32768"/>
    <param name="rtp-timeout" value="120"/>             <!-- hang up calls with no RTP for N seconds (0 = off) -->
    <!-- Codecs RingQswitch can terminate itself (IVR, playback, echo...).
         Bridged calls pass any codec through untouched. -->
    <param name="codec-prefs" value="PCMU,PCMA"/>

    <!-- Security -->
    <param name="domain" value="$${domain}"/>
    <param name="auth-calls" value="true"/>             <!-- challenge INVITEs from untrusted sources -->
    <param name="auth-fail-threshold" value="10"/>      <!-- failed auths per window before blocking -->
    <param name="auth-fail-window" value="60"/>
    <param name="auth-block-seconds" value="600"/>
    <param name="min-register-expires" value="60"/>
    <param name="max-register-expires" value="3600"/>
    <param name="default-register-expires" value="3600"/>
    <param name="max-sessions" value="1000"/>
    <param name="call-timeout" value="60"/>             <!-- default ring timeout for bridge -->

    <!-- Event socket (ESL style control protocol) used by rq_cli. -->
    <param name="event-socket-listen" value="127.0.0.1:8021"/>
    <param name="event-socket-password" value="ChangeMe-ESL"/>

    <!-- Files (relative paths are relative to this directory). -->
    <param name="cdr-csv" value="../log/cdr.csv"/>      <!-- empty disables CDRs -->
    <param name="sounds-dir" value="../sounds"/>
    <param name="recordings-dir" value="../recordings"/>
    <param name="voicemail-dir" value="../voicemail"/>
    <!-- Faxes (eFax, rxfax/txfax); default: "fax" next to recordings-dir. -->
    <!-- <param name="fax-dir" value="../fax"/> -->
    <!-- Call transcription (web interface → Settings → Call transcription;
         packaging/install-transcription.sh installs the recogniser). Found
         by itself in /usr/local/bin and /usr/local/share/ringqswitch/speech. -->
    <!-- <param name="transcribe-command" value="/usr/local/bin/rq-speech"/> -->
    <!-- <param name="transcribe-model" value="/usr/local/share/ringqswitch/speech/ggml-small.bin"/> -->
    <!-- <param name="transcribe-threads" value="4"/> -->      <!-- CPU threads per call (default: half the CPUs, at most 4) -->
    <!-- <param name="transcribe-workers" value="1"/> -->      <!-- calls transcribed at the same time -->
    <!-- <param name="transcribe-min-seconds" value="5"/> -->  <!-- shorter calls (billsec) are not transcribed -->
    <!-- Where Settings → Call transcription downloads speech models from
         (default: the speech model library on the internet; a mirror
         holding the same ggml-<model>.bin files works too). -->
    <!-- <param name="transcribe-model-url" value="https://models.example.com/speech"/> -->
    <!-- Live transcription during calls (Settings → Call transcription):
         RingQswitch starts rq-speech-server (installed next to rq-speech)
         on 127.0.0.1 when a call is first written down live. To use a
         live recogniser started elsewhere instead, give its address. -->
    <!-- <param name="transcribe-live-url" value="http://127.0.0.1:8178"/> -->
  </settings>

  <!--
    SIP trunks. Dial out with bridge gateway/<name>/<number>.
    Calls arriving from a gateway's address are routed to its context.
  -->
  <gateways>
    <!--
    <gateway name="carrier">
      <param name="proxy" value="sip.carrier.example:5060"/>
      <param name="username" value="account"/>
      <param name="password" value="secret"/>
      <param name="register" value="true"/>
      <param name="expire-seconds" value="600"/>
      <param name="context" value="public"/>
      <param name="caller-id-in-from" value="false"/>
    </gateway>
    -->
  </gateways>

  <!--
    PostgreSQL with the RingQ database. When a dsn is
    set, domains, extensions, gateways, dialplans, ring groups, IVR menus
    and v_vars come from the database (the XML users and dialplan in this
    directory are then ignored unless xml-directory / xml-dialplan are
    true), changes are picked up automatically, and registrations, channels,
    calls and CDRs are written back. See docs/DATABASE.md and the complete
    example in conf/examples/ringq-postgres.xml.
  -->
  <database>
    <!-- <param name="dsn" value="postgres://DBUSER:PASSWORD@127.0.0.1:5432/DBNAME?sslmode=disable"/> -->
    <!-- <param name="cdr-tables" value="v_xml_cdr"/> -->
    <!-- Other database users that may read and change RingQswitch's own
         tables (rq_*), e.g. the user your database tool signs in with. The database
         owner and the owner of the RingQ tables always may. -->
    <!-- <param name="grant-to" value="ringq"/> -->
  </database>

  <!-- Web interface (needs the database for the configuration pages; the
       dashboard, call centre and logs also work without it). -->
  <web>
    <!-- <param name="listen" value="0.0.0.0:8443"/> -->
    <!-- <param name="admin-password" value="at-least-8-characters"/> -->
  </web>

  <!-- Trusted networks: calls from these skip digest auth. -->
  <acl>
    <!-- <node cidr="198.51.100.10/32" context="public" name="pstn-gateway"/> -->
  </acl>
</configuration>
